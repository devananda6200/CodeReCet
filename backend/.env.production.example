# Production Environment Configuration
# Use this for deployed environments (Render, Cloud Run, etc.)

OPS_APP_NAME=Ops Safety System API
OPS_ENVIRONMENT=production
OPS_DEMO_MODE=false
OPS_DEMO_SEED_STREAMS=0
OPS_MODEL_PATH=models/best.pt
OPS_DEFAULT_BACKEND=pytorch
OPS_DEFAULT_CPU_THREADS=4
OPS_MAX_CPU_THREADS=8
OPS_DEFAULT_CONFIDENCE=0.35
OPS_DEFAULT_IOU=0.45
OPS_DEFAULT_FRAME_SKIP=4
OPS_ALERT_PERSISTENCE_FRAMES=3
OPS_ADAPTIVE_RESOLUTION=true
OPS_DEFAULT_INPUT_SIZE=512

# For production, allow requests from your deployed frontend
# Replace with your actual Vercel/frontend URL
OPS_ALLOWED_ORIGINS=["https://ops-safety-frontend-xxxxx.vercel.app"]
